# Geon's settings: /etc/geon/geon.env (mode 640, group geon), read by geon.service
# and by geon-import.sh. Every `geon` option can be set here as GEON_ plus the option
# name in upper case with - written as _ (-listen-port is GEON_LISTEN_PORT); the
# command line wins over these. `geon --help` lists the options.

# Where the index lives (geon.idx). geon-import.sh writes it here.
GEON_DATA_DIR=/var/lib/geon

# The Photon compatible API. Keep it on loopback behind a reverse proxy (Caddy,
# nginx), or set 0.0.0.0 to serve it directly.
GEON_LISTEN_IP=127.0.0.1
GEON_LISTEN_PORT=2322

# The admin port: /health, /info and /metrics (Prometheus). Never expose it; scrape
# it locally or through an SSH tunnel. Set GEON_ADMIN_PORT=none to turn it off.
GEON_ADMIN_IP=127.0.0.1
GEON_ADMIN_PORT=2323

# Browser access from other origins, if a web page calls the API directly.
#GEON_CORS_ORIGIN=example.com,www.example.com
#GEON_CORS_ANY=true

# Search tuning.
#GEON_DEFAULT_LANGUAGE=default
#GEON_MAX_RESULTS=50
#GEON_MAX_REVERSE_RESULTS=50
#GEON_SYNONYM_FILE=/etc/geon/synonyms.json

# Import settings, used by geon-import.sh.
GEON_LANGUAGES=en,de,fr,it
#GEON_EXTRA_TAGS=ALL
#GEON_COUNTRY_CODES=de,at,ch
# Memory for postings before they spill to disk. The native binary sizes its heap
# from the machine's memory; keep this well below it.
GEON_IMPORT_MEMORY=1g
#GEON_TMP_DIR=/var/lib/geon/tmp

# Logging (Rainbow Gum; GEON_LOG_X is the property logging.X). The journal adds the
# time and reads each line's level from its <6>-style prefix, so a line is the
# level, logger and message in tab separated columns, then the rest as LTSV
# (label:value): thread, geon.version and git.commit.
GEON_LOG_appender_console_encoder_uri=ltsv
GEON_LOG_appender_console_encoder_ltsv_timestamp=none
GEON_LOG_appender_console_encoder_ltsv_columns=level,logger,message
GEON_LOG_appender_console_encoder_postProcessors=journald
#GEON_LOG_level=info
#GEON_LOG_level_io_netty=warning
